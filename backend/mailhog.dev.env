# Local email capture with MailHog (matches project: reminders, monthly HTML, CSV alerts — all via Flask-Mail).
#
# Terminal A — start MailHog (SMTP :1025, web UI :8025):
#   ~/go/bin/MailHog
# Then open: http://127.0.0.1:8025
#
# Before python app.py AND before celery worker, load this in EACH terminal:
#   cd .../backend && set -a && source mailhog.dev.env && set +a
#
export USE_MAILHOG=1
